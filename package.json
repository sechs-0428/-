{
  "name": "caremanager-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "事業所で共有できるケアマネ業務管理ソフト",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "CareManager",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node server/server.mjs --data-dir .local-data --port 43180",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build": "tsc -b && vite build",
    "test": "node --test tests/*.test.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "check:package": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "jp.caremanager.desktop",
    "productName": "CareManager",
    "asar": true,
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
